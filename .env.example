# Copier ce fichier en .env puis remplacer les valeurs.
# Mots de passe : lettres et chiffres uniquement (évite les soucis PowerShell / URI).
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_DB=healthcare
MIGRATION_PASSWORD=changeme
ANALYST_PASSWORD=changeme
HEALTHCARE_ADMIN_PASSWORD=changeme

# Pour lancer les scripts Python hors Docker (depuis le dossier migration/).
# Le script se connecte en migration_user avec MIGRATION_PASSWORD.
MONGO_HOST=localhost
CSV_PATH=../data/healthcare_dataset.csv
EXPORT_DIR=../exports
